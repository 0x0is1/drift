SUPABASE_URL=
SUPABASE_ANON_KEY=
JIOSAAVN_BASE_URL=https://www.jiosaavn.com/api.php?__call=
PORT=4000

# The sb_secret_/service_role key must NEVER go here — the backend scopes
# every request with the caller's own forwarded JWT + the anon key above,
# so Postgres RLS still enforces per-user access. No service-role key is
# needed for anything this backend does.
